# Server
PORT=3001

# Email (SMTP) — use Gmail App Password or any SMTP provider
# To use Gmail: enable 2FA, then generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Where to receive lead notifications (your inbox)
NOTIFY_EMAIL=support@sitewell.info

# Secret token to view collected leads at GET /api/leads?secret=...
LEADS_SECRET=change-this-to-a-random-string

# CORS — set to your live domain
ALLOWED_ORIGIN=https://henrycubric.github.io
